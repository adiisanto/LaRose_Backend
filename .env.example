# ============================================================================
# APP CONFIGURATION
# ============================================================================
ENVIRONMENT=development
DEBUG=true
APP_NAME="LaRose Floral Studio Backend"
APP_VERSION="0.1.0"
API_V1_PREFIX="/api/v1"

# ============================================================================
# DATABASE (SUPABASE POSTGRESQL)
# ============================================================================
# Format: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@[YOUR-SUPABASE-HOST]:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/larose_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30

# ============================================================================
# SECURITY & JWT
# ============================================================================
JWT_SECRET_KEY=change_this_to_a_super_secret_key_at_least_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# CORS (ORIGINS ALLOWED TO CONNECT)
# ============================================================================
# Comma-separated domains
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://larose.vercel.app
